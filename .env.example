# Copy to .env and adjust.
# Paths are RELATIVE to the compose file directory (this stack root).
# Docker Compose resolves ./config, ./media, ./downloads relative to
# docker-compose.yml — copy/rsync the whole folder and the stack moves with it.
#
# SSD space: prefer compressed x265/HEVC (and AV1) over remux/BluRay dumps.
# See docs/space-saving.md — set Sonarr/Radarr quality profiles before big grabs.
# Optional overnight shrink: docker compose --profile compress up -d (Unmanic).
#
# Optional absolute override (Windows Docker Desktop style), if media lives
# on a separate drive later:
#   CONFIG_ROOT=D:/media-server/config
#   MEDIA_ROOT=E:/media
#   DOWNLOADS_ROOT=D:/media-server/downloads

# ── Paths (portable — relative to stack root) ───────────────────────────────
CONFIG_ROOT=./config
MEDIA_ROOT=./media
DOWNLOADS_ROOT=./downloads

# ── Identity / timezone ─────────────────────────────────────────────────────
# linuxserver images expect PUID/PGID. On Docker Desktop + WSL2 these usually
# work as-is at 1000. If file ownership on bind mounts looks wrong, check the
# WSL distro user id (`id -u` / `id -g` inside WSL) or fix ACLs on the data folder.
# On a dedicated Linux box, set these to the user that owns the stack folder.
PUID=1000
PGID=1000
TZ=America/Los_Angeles

# ── Ports (chosen to avoid common Steam/game server defaults where practical) ─
JELLYFIN_PORT=8096
JELLYFIN_HTTPS_PORT=8920
QBIT_WEBUI_PORT=8080
QBIT_BT_PORT=6881
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
BAZARR_PORT=6767
LIDARR_PORT=8686
OVERSEERR_PORT=5055
FLARESOLVERR_PORT=8191
NICOTINE_HTTP_PORT=6080
NICOTINE_HTTPS_PORT=6081
UNMANIC_PORT=8888
PIHOLE_DNS_PORT=53
PIHOLE_WEB_PORT=8053

# ── Pi-hole ─────────────────────────────────────────────────────────────────
# Change before first start. Admin UI: http://localhost:8053/admin
PIHOLE_PASSWORD=changeme

# ── FlareSolverr ────────────────────────────────────────────────────────────
FLARESOLVERR_LOG_LEVEL=info

# ── Jellyfin remote (Tailscale) ─────────────────────────────────────────────
# Install Tailscale on the Windows HOST (not required in Docker on this PC).
# Then set this to your MagicDNS name or Tailscale IP so apps get correct links:
#   JELLYFIN_PublishedServerUrl=http://desktop-fh9ksh7:8096
#   JELLYFIN_PublishedServerUrl=http://100.x.y.z:8096
# Leave empty for LAN-only. Do NOT router port-forward 8096 — use Tailscale instead.
# Full steps: docs/tailscale.md
JELLYFIN_PublishedServerUrl=

# Homarr dashboard
HOMARR_PORT=7575
HOMARR_SECRET_ENCRYPTION_KEY=  # openssl rand -hex 32
# JELLYFIN_PublishedServerUrl=http://192.168.4.42:8096
