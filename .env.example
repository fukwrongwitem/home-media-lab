# Copy to .env and adjust.
# Paths are RELATIVE to the compose file directory (this stack root).
# Docker Compose resolves ./config, ./media, ./work relative to
# docker-compose.yml - copy/rsync the whole folder and the stack moves with it.
#
# SSD space: keep a lossless MKV of a disc only until the HEVC encode is checked.
# See docs/space-saving.md and docs/disc-ripping.md.
# Optional overnight shrink of older files: docker compose --profile compress up -d (Unmanic).
#
# Optional absolute override (Windows Docker Desktop style), e.g. rip staging
# on a secondary volume while config stays portable:
#   CONFIG_ROOT=./config
#   MEDIA_ROOT=./media
#   WORK_ROOT=E:/media-server/work

# -- Paths (portable - relative to stack root) --------------------------------
CONFIG_ROOT=./config
MEDIA_ROOT=./media
# Scratch space: raw disc rips waiting to be encoded, Unmanic cache
WORK_ROOT=./work

# -- Identity / timezone ------------------------------------------------------
# linuxserver-style images expect PUID/PGID. On Docker Desktop + WSL2 these usually
# work as-is at 1000. If file ownership on bind mounts looks wrong, check the
# WSL distro user id (`id -u` / `id -g` inside WSL) or fix ACLs on the data folder.
# On a dedicated Linux box, set these to the user that owns the stack folder.
PUID=1000
PGID=1000
TZ=America/Los_Angeles

# -- Ports (chosen to avoid common Steam/game server defaults where practical) -
JELLYFIN_PORT=8096
JELLYFIN_HTTPS_PORT=8920
UNMANIC_PORT=8888
# Pi-hole: on Windows, bind DNS to loopback on a free non-default port and
# forward :53 to it from the host (docs/dns.md). On Linux: 0.0.0.0 and 53.
PIHOLE_DNS_BIND=127.0.0.1
PIHOLE_DNS_PORT=53
# Pick a free host port for the Pi-hole web UI
PIHOLE_WEB_PORT=

# -- Pi-hole ------------------------------------------------------------------
# Change before first start. Admin UI: http://localhost:<PIHOLE_WEB_PORT>/admin
PIHOLE_PASSWORD=changeme

# -- Jellyfin remote (Tailscale) ----------------------------------------------
# Install Tailscale on the Windows HOST (not required in Docker on this PC).
# Then set this to the machine's Tailscale hostname or Tailscale IP so apps get correct links:
#   JELLYFIN_PublishedServerUrl=http://<tailscale-hostname-or-ip>:8096
# Leave empty for LAN-only. Do NOT router port-forward 8096 - use Tailscale instead.
# Full steps: docs/tailscale.md
JELLYFIN_PublishedServerUrl=

# Homarr dashboard
HOMARR_PORT=7575
# Generate: openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=
